generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AssuranceLevel {
  PASSWORD
  MFA
  STEP_UP
}

enum SessionState {
  ACTIVE
  REVOKED
  EXPIRED
}

enum GeographyType {
  COUNTRY
  REGION
  DISTRICT
  CITY
  ZONE
  NEIGHBORHOOD
}

enum AreaStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ActorType {
  USER
  SYSTEM
  PROVIDER
  AI_AGENT
}

enum MfaState {
  PENDING
  ACTIVE
  REVOKED
}

enum StorageObjectState {
  PENDING_UPLOAD
  UPLOADED
  QUARANTINED
  DELETED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum KycSubjectType {
  VENDOR
  RIDER
  ADMIN
}

enum KycCaseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION
  APPROVED
  REJECTED
  REVOKED
}

enum KycDecision {
  START_REVIEW
  APPROVE
  REJECT
  REQUEST_MORE_INFORMATION
  REVOKE
}

enum PartyStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum VendorMembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum RiderVehicleType {
  BICYCLE
  MOTORBIKE
  CAR
  OTHER
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductModerationState {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CategoryStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum ProductImageStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InventoryMovementKind {
  ADJUST
  RESERVE
  RELEASE
  CONSUME
  EXPIRE
}

enum InventoryReservationState {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id                     String                 @id @default(uuid()) @db.Uuid
  emailNormalized        String?                @unique
  emailVerifiedAt        DateTime?
  phoneE164              String?
  phoneVerifiedAt        DateTime?
  displayName            String
  status                 UserStatus             @default(ACTIVE)
  authorizationVersion   Int                    @default(1)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  identities             UserIdentity[]
  sessions               Session[]
  roles                  UserRole[]
  scopes                 AdminScope[]
  auditLogs              AuditLog[]
  mfa                    UserMfa?
  recoveryCodes          RecoveryCode[]
  storageObjects         StorageObject[]
  reviewedStorageObjects StorageObject[]        @relation("StorageObjectReviewedBy")
  ledgerAccounts         LedgerAccount[]
  ledgerJournals         LedgerJournal[]
  kycCases               KycCase[]              @relation("KycCaseSubject")
  kycReviews             KycReview[]            @relation("KycReviewReviewer")
  kycDocumentsLinked     KycDocument[]          @relation("KycDocumentLinkedBy")
  ownedVendors           Vendor[]               @relation("VendorOwner")
  activatedVendors       Vendor[]               @relation("VendorActivatedBy")
  vendorMemberships      VendorMembership[]
  riderProfile           RiderProfile?          @relation("RiderProfileUser")
  activatedRiderProfiles RiderProfile[]         @relation("RiderActivatedBy")
  activatedStores        Store[]                @relation("StoreActivatedBy")
  createdProducts        Product[]              @relation("ProductCreatedBy")
  reviewedProducts       Product[]              @relation("ProductReviewedBy")
  publishedProducts      Product[]              @relation("ProductPublishedBy")
  createdCategories      Category[]             @relation("CategoryCreatedBy")
  activatedCategories    Category[]             @relation("CategoryActivatedBy")
  createdProductImages   ProductImage[]         @relation("ProductImageCreatedBy")
  reviewedProductImages  ProductImage[]         @relation("ProductImageReviewedBy")
  inventoryMovements     InventoryMovement[]
  inventoryReservations  InventoryReservation[]
  carts                  Cart[]
  checkoutQuotes         CheckoutQuote[]
}

model UserIdentity {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  issuer                String
  subject               String
  providerKey           String
  providerEmailVerified Boolean  @default(false)
  linkedAt              DateTime @default(now())
  lastVerifiedAt        DateTime
  user                  User     @relation(fields: [userId], references: [id])

  @@unique([issuer, subject])
  @@unique([userId, issuer])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  resource    String
  action      String
  sensitivity String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  grantedBy String    @db.Uuid
  expiresAt DateTime?
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model AdminScope {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  geographyType  GeographyType
  countryId      String?       @db.Uuid
  regionId       String?       @db.Uuid
  districtId     String?       @db.Uuid
  cityId         String?       @db.Uuid
  serviceZoneId  String?       @db.Uuid
  neighborhoodId String?       @db.Uuid
  grantedBy      String        @db.Uuid
  effectiveFrom  DateTime      @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  user           User          @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
}

model Session {
  id                     String         @id @default(uuid()) @db.Uuid
  userId                 String         @db.Uuid
  tokenHash              String         @unique
  assuranceLevel         AssuranceLevel @default(PASSWORD)
  state                  SessionState   @default(ACTIVE)
  encryptedTokenEnvelope Bytes?
  expiresAt              DateTime
  idleExpiresAt          DateTime
  revokedAt              DateTime?
  revokedReason          String?        @db.VarChar(120)
  authVersion            Int
  deviceLabel            String?        @db.VarChar(120)
  ipHash                 String?        @db.VarChar(64)
  userAgentHash          String?        @db.VarChar(64)
  stepUpExpiresAt        DateTime?
  createdAt              DateTime       @default(now())
  user                   User           @relation(fields: [userId], references: [id])

  @@index([userId, state])
}

model Country {
  id             String          @id @default(uuid()) @db.Uuid
  iso2           String          @unique
  name           String
  currencyCode   String
  callingCode    String
  timezone       String
  status         AreaStatus      @default(DRAFT)
  regions        Region[]
  kycCases       KycCase[]
  vendors        Vendor[]
  riderProfiles  RiderProfile[]
  stores         Store[]
  products       Product[]
  categories     Category[]
  productImages  ProductImage[]
  inventories    Inventory[]
  carts          Cart[]
  checkoutQuotes CheckoutQuote[]
}

model Region {
  id        String     @id @default(uuid()) @db.Uuid
  countryId String     @db.Uuid
  code      String
  name      String
  status    AreaStatus @default(DRAFT)
  country   Country    @relation(fields: [countryId], references: [id])
  districts District[]

  @@unique([countryId, code])
}

model District {
  id       String     @id @default(uuid()) @db.Uuid
  regionId String     @db.Uuid
  code     String
  name     String
  status   AreaStatus @default(DRAFT)
  region   Region     @relation(fields: [regionId], references: [id])
  cities   City[]

  @@unique([regionId, code])
}

model City {
  id             String          @id @default(uuid()) @db.Uuid
  districtId     String          @db.Uuid
  code           String
  name           String
  kind           String
  status         AreaStatus      @default(DRAFT)
  district       District        @relation(fields: [districtId], references: [id])
  zones          ServiceZone[]
  stores         Store[]
  checkoutQuotes CheckoutQuote[] @relation("CheckoutQuoteDestinationCity")

  @@unique([districtId, code])
}

model ServiceZone {
  id            String         @id @default(uuid()) @db.Uuid
  cityId        String         @db.Uuid
  code          String
  name          String
  status        AreaStatus     @default(DRAFT)
  priority      Int            @default(0)
  city          City           @relation(fields: [cityId], references: [id])
  neighborhoods Neighborhood[]

  @@unique([cityId, code])
}

model Neighborhood {
  id            String      @id @default(uuid()) @db.Uuid
  serviceZoneId String      @db.Uuid
  code          String
  name          String
  zone          ServiceZone @relation(fields: [serviceZoneId], references: [id])

  @@unique([serviceZoneId, code])
}

model BoundaryVersion {
  id          String                                     @id @default(uuid()) @db.Uuid
  ownerType   GeographyType
  ownerId     String                                     @db.Uuid
  version     Int
  boundary    Unsupported("geometry(MultiPolygon,4326)")
  source      String
  validFrom   DateTime
  approvedBy  String?                                    @db.Uuid
  contentHash String
  createdAt   DateTime                                   @default(now())

  @@unique([ownerType, ownerId, version])
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  actorId        String?   @db.Uuid
  actorType      ActorType
  sessionId      String?   @db.Uuid
  action         String
  resourceType   String
  resourceId     String?   @db.Uuid
  scopeSnapshot  Json
  beforeRedacted Json?
  afterRedacted  Json?
  reason         String?
  requestId      String
  occurredAt     DateTime  @default(now())
  actor          User?     @relation(fields: [actorId], references: [id])

  @@index([resourceType, resourceId, occurredAt])
  @@index([actorId, occurredAt])
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String    @db.Uuid
  eventKey      String    @unique
  eventType     String
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now())
  lastError     String?
  failedAt      DateTime?
  leaseToken    String?   @db.Uuid
  leaseUntil    DateTime?

  @@index([publishedAt, occurredAt])
  @@index([availableAt, occurredAt])
  @@index([leaseUntil], map: "OutboxEvent_lease_idx")
}

model InboxReceipt {
  consumer    String
  eventKey    String
  processedAt DateTime @default(now())

  @@id([consumer, eventKey])
}

model InboxDeadLetter {
  id            String   @id @default(uuid()) @db.Uuid
  consumer      String   @db.VarChar(128)
  eventKey      String?  @db.VarChar(128)
  eventType     String?  @db.VarChar(128)
  payloadHash   String   @db.VarChar(64)
  payload       Json
  errorCode     String   @db.VarChar(64)
  attempts      Int
  firstFailedAt DateTime @default(now())
  lastFailedAt  DateTime @default(now())

  @@unique([consumer, payloadHash])
  @@index([consumer, lastFailedAt])
}

model IdempotencyRecord {
  id                String           @id @default(uuid()) @db.Uuid
  actorId           String           @db.Uuid
  route             String
  key               String
  requestHash       String
  responseStatus    Int?
  responseHash      String?
  resourceReference String?
  state             IdempotencyState @default(IN_PROGRESS)
  expiresAt         DateTime
  createdAt         DateTime         @default(now())

  @@unique([actorId, route, key])
}

model FeatureFlag {
  id          String  @id @default(uuid()) @db.Uuid
  key         String
  countryId   String? @db.Uuid
  environment String
  enabled     Boolean @default(false)
  rolloutRule Json
  version     Int     @default(1)
  updatedBy   String  @db.Uuid

  @@unique([key, countryId, environment])
}

model UserMfa {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  secretEnvelope  Bytes
  state           MfaState  @default(PENDING)
  digits          Int       @default(6)
  period          Int       @default(30)
  lastUsedCounter BigInt    @default(-1)
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(64)
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, codeHash])
}

model StorageObject {
  id               String             @id @default(uuid()) @db.Uuid
  ownerUserId      String             @db.Uuid
  purpose          String             @db.VarChar(64)
  objectKey        String             @unique @db.VarChar(512)
  contentType      String             @db.VarChar(120)
  sizeBytes        BigInt?
  sha256           String?            @db.VarChar(64)
  state            StorageObjectState @default(PENDING_UPLOAD)
  magicValid       Boolean            @default(false)
  encryptionKeyId  String             @db.VarChar(120)
  expiresAt        DateTime?
  deletedAt        DateTime?
  reviewedByUserId String?            @db.Uuid
  reviewedAt       DateTime?
  reviewReason     String?            @db.VarChar(512)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  owner            User               @relation(fields: [ownerUserId], references: [id])
  reviewedBy       User?              @relation("StorageObjectReviewedBy", fields: [reviewedByUserId], references: [id])
  kycDocument      KycDocument?
  productImage     ProductImage?

  @@index([ownerUserId, purpose, state])
  @@index([state, createdAt])
}

model LedgerAccount {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @unique @db.VarChar(64)
  name            String            @db.VarChar(128)
  type            LedgerAccountType
  currency        String            @db.VarChar(3)
  createdByUserId String            @db.Uuid
  createdAt       DateTime          @default(now())
  createdBy       User              @relation(fields: [createdByUserId], references: [id])
  lines           LedgerLine[]
}

model LedgerJournal {
  id                  String          @id @default(uuid()) @db.Uuid
  businessEventKey    String          @unique @db.VarChar(128)
  payloadHash         String          @db.VarChar(64)
  currency            String          @db.VarChar(3)
  description         String          @db.VarChar(512)
  occurredAt          DateTime        @default(now())
  createdByUserId     String          @db.Uuid
  createdAt           DateTime        @default(now())
  reversalOfJournalId String?         @db.Uuid
  createdBy           User            @relation(fields: [createdByUserId], references: [id])
  reversalOf          LedgerJournal?  @relation("LedgerJournalReversal", fields: [reversalOfJournalId], references: [id])
  reversals           LedgerJournal[] @relation("LedgerJournalReversal")
  lines               LedgerLine[]

  @@index([createdAt])
}

model LedgerLine {
  id          String        @id @default(uuid()) @db.Uuid
  journalId   String        @db.Uuid
  accountId   String        @db.Uuid
  side        LedgerSide
  amountMinor BigInt
  lineNo      Int
  createdAt   DateTime      @default(now())
  journal     LedgerJournal @relation(fields: [journalId], references: [id])
  account     LedgerAccount @relation(fields: [accountId], references: [id])

  @@unique([journalId, lineNo])
  @@index([accountId])
}

model KycCase {
  id             String         @id @default(uuid()) @db.Uuid
  subjectUserId  String         @db.Uuid
  subjectType    KycSubjectType
  countryId      String         @db.Uuid
  status         KycCaseStatus  @default(DRAFT)
  policyVersion  String         @db.VarChar(64)
  consentVersion String         @db.VarChar(64)
  consentedAt    DateTime
  version        Int            @default(1)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subject        User           @relation("KycCaseSubject", fields: [subjectUserId], references: [id])
  country        Country        @relation(fields: [countryId], references: [id])
  documents      KycDocument[]
  reviews        KycReview[]
  vendor         Vendor?        @relation("VendorKycCase")
  riderProfile   RiderProfile?  @relation("RiderKycCase")

  @@index([subjectUserId, subjectType, status])
  @@index([countryId, status, createdAt])
}

model KycDocument {
  id              String        @id @default(uuid()) @db.Uuid
  caseId          String        @db.Uuid
  storageObjectId String        @unique @db.Uuid
  documentType    String        @db.VarChar(64)
  contentHash     String        @db.VarChar(64)
  expiresAt       DateTime?
  linkedByUserId  String        @db.Uuid
  createdAt       DateTime      @default(now())
  case            KycCase       @relation(fields: [caseId], references: [id])
  storageObject   StorageObject @relation(fields: [storageObjectId], references: [id])
  linkedBy        User          @relation("KycDocumentLinkedBy", fields: [linkedByUserId], references: [id])

  @@index([caseId])
}

model KycReview {
  id                 String        @id @default(uuid()) @db.Uuid
  caseId             String        @db.Uuid
  reviewerUserId     String        @db.Uuid
  commandKey         String        @db.VarChar(128)
  payloadHash        String        @db.VarChar(64)
  decision           KycDecision
  fromStatus         KycCaseStatus
  toStatus           KycCaseStatus
  reason             String        @db.VarChar(512)
  verificationMethod String        @default("MANUAL_DOCUMENT_REVIEW") @db.VarChar(64)
  occurredAt         DateTime      @default(now())
  case               KycCase       @relation(fields: [caseId], references: [id])
  reviewer           User          @relation("KycReviewReviewer", fields: [reviewerUserId], references: [id])

  @@unique([caseId, commandKey])
  @@index([caseId, occurredAt])
}

model Vendor {
  id                String             @id @default(uuid()) @db.Uuid
  ownerUserId       String             @db.Uuid
  countryId         String             @db.Uuid
  displayName       String             @db.VarChar(120)
  legalName         String?            @db.VarChar(200)
  status            PartyStatus        @default(DRAFT)
  kycCaseId         String?            @unique @db.Uuid
  activatedAt       DateTime?
  activatedByUserId String?            @db.Uuid
  suspendedAt       DateTime?
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  owner             User               @relation("VendorOwner", fields: [ownerUserId], references: [id])
  country           Country            @relation(fields: [countryId], references: [id])
  kycCase           KycCase?           @relation("VendorKycCase", fields: [kycCaseId], references: [id])
  activatedBy       User?              @relation("VendorActivatedBy", fields: [activatedByUserId], references: [id])
  memberships       VendorMembership[]
  stores            Store[]
  products          Product[]
  Inventory         Inventory[]

  @@unique([ownerUserId, countryId])
  @@index([countryId, status])
}

model VendorMembership {
  id        String               @id @default(uuid()) @db.Uuid
  vendorId  String               @db.Uuid
  userId    String               @db.Uuid
  role      VendorMembershipRole
  grantedBy String               @db.Uuid
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime             @default(now())
  vendor    Vendor               @relation(fields: [vendorId], references: [id])
  user      User                 @relation(fields: [userId], references: [id])

  @@unique([vendorId, userId])
  @@index([userId, revokedAt])
}

model RiderProfile {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @unique @db.Uuid
  countryId         String           @db.Uuid
  vehicleType       RiderVehicleType
  status            PartyStatus      @default(DRAFT)
  kycCaseId         String?          @unique @db.Uuid
  activatedAt       DateTime?
  activatedByUserId String?          @db.Uuid
  suspendedAt       DateTime?
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation("RiderProfileUser", fields: [userId], references: [id])
  country           Country          @relation(fields: [countryId], references: [id])
  kycCase           KycCase?         @relation("RiderKycCase", fields: [kycCaseId], references: [id])
  activatedBy       User?            @relation("RiderActivatedBy", fields: [activatedByUserId], references: [id])

  @@index([countryId, status])
}

model Store {
  id                String               @id @default(uuid()) @db.Uuid
  vendorId          String               @db.Uuid
  countryId         String               @db.Uuid
  cityId            String               @db.Uuid
  name              String               @db.VarChar(120)
  slug              String               @db.VarChar(140)
  addressLine       String               @db.VarChar(500)
  status            StoreStatus          @default(DRAFT)
  activatedAt       DateTime?
  activatedByUserId String?              @db.Uuid
  suspendedAt       DateTime?
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  vendor            Vendor               @relation(fields: [vendorId], references: [id])
  country           Country              @relation(fields: [countryId], references: [id])
  city              City                 @relation(fields: [cityId], references: [id])
  activatedBy       User?                @relation("StoreActivatedBy", fields: [activatedByUserId], references: [id])
  products          Product[]
  inventories       Inventory[]
  cartItems         CartItem[]
  checkoutGroups    CheckoutQuoteGroup[]

  @@unique([vendorId, slug])
  @@index([countryId, status])
  @@index([cityId, status])
}

model Product {
  id                String                 @id @default(uuid()) @db.Uuid
  vendorId          String                 @db.Uuid
  storeId           String                 @db.Uuid
  countryId         String                 @db.Uuid
  categoryId        String?                @db.Uuid
  title             String                 @db.VarChar(200)
  description       String                 @db.VarChar(5000)
  brand             String?                @db.VarChar(120)
  status            ProductStatus          @default(DRAFT)
  moderationState   ProductModerationState @default(NOT_SUBMITTED)
  moderationReason  String?                @db.VarChar(512)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedByUserId  String?                @db.Uuid
  publishedAt       DateTime?
  publishedByUserId String?                @db.Uuid
  version           Int                    @default(1)
  createdByUserId   String                 @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  vendor            Vendor                 @relation(fields: [vendorId], references: [id])
  store             Store                  @relation(fields: [storeId], references: [id])
  country           Country                @relation(fields: [countryId], references: [id])
  category          Category?              @relation(fields: [categoryId], references: [id])
  createdBy         User                   @relation("ProductCreatedBy", fields: [createdByUserId], references: [id])
  reviewedBy        User?                  @relation("ProductReviewedBy", fields: [reviewedByUserId], references: [id])
  publishedBy       User?                  @relation("ProductPublishedBy", fields: [publishedByUserId], references: [id])
  variants          ProductVariant[]
  images            ProductImage[]

  @@index([storeId, status])
  @@index([vendorId, status])
  @@index([countryId, status])
  @@index([countryId, moderationState, createdAt])
  @@index([countryId, status, createdAt, id])
  @@index([categoryId, status])
}

model ProductVariant {
  id                   String              @id @default(uuid()) @db.Uuid
  productId            String              @db.Uuid
  sku                  String              @db.VarChar(120)
  optionValues         Json
  priceAmountMinor     BigInt
  compareAtAmountMinor BigInt?
  currency             String              @db.VarChar(3)
  weightGrams          Int?
  active               Boolean             @default(true)
  version              Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  product              Product             @relation(fields: [productId], references: [id])
  inventory            Inventory?
  cartItems            CartItem[]
  checkoutQuoteItems   CheckoutQuoteItem[]

  @@unique([productId, sku])
  @@index([productId, active])
}

model Category {
  id                String         @id @default(uuid()) @db.Uuid
  countryId         String         @db.Uuid
  parentId          String?        @db.Uuid
  name              String         @db.VarChar(120)
  slug              String         @db.VarChar(140)
  description       String?        @db.VarChar(500)
  status            CategoryStatus @default(DRAFT)
  sortOrder         Int            @default(0)
  version           Int            @default(1)
  createdByUserId   String         @db.Uuid
  activatedByUserId String?        @db.Uuid
  suspendedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  country           Country        @relation(fields: [countryId], references: [id])
  parent            Category?      @relation("CategoryParent", fields: [parentId], references: [id])
  children          Category[]     @relation("CategoryParent")
  createdBy         User           @relation("CategoryCreatedBy", fields: [createdByUserId], references: [id])
  activatedBy       User?          @relation("CategoryActivatedBy", fields: [activatedByUserId], references: [id])
  products          Product[]

  @@unique([countryId, slug])
  @@index([countryId, status, sortOrder])
  @@index([parentId, status])
}

model ProductImage {
  id               String             @id @default(uuid()) @db.Uuid
  productId        String             @db.Uuid
  storageObjectId  String             @unique @db.Uuid
  countryId        String             @db.Uuid
  altText          String             @db.VarChar(180)
  sortOrder        Int                @default(0)
  state            ProductImageStatus @default(PENDING_REVIEW)
  version          Int                @default(1)
  createdByUserId  String             @db.Uuid
  reviewedByUserId String?            @db.Uuid
  reviewedAt       DateTime?
  reviewReason     String?            @db.VarChar(512)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  product          Product            @relation(fields: [productId], references: [id])
  storageObject    StorageObject      @relation(fields: [storageObjectId], references: [id])
  country          Country            @relation(fields: [countryId], references: [id])
  createdBy        User               @relation("ProductImageCreatedBy", fields: [createdByUserId], references: [id])
  reviewedBy       User?              @relation("ProductImageReviewedBy", fields: [reviewedByUserId], references: [id])

  @@unique([productId, sortOrder])
  @@index([productId, state])
  @@index([countryId, state, createdAt])
}

model Inventory {
  id           String                 @id @default(uuid()) @db.Uuid
  variantId    String                 @unique @db.Uuid
  storeId      String                 @db.Uuid
  vendorId     String                 @db.Uuid
  countryId    String                 @db.Uuid
  onHand       Int                    @default(0)
  reserved     Int                    @default(0)
  reorderLevel Int                    @default(0)
  version      Int                    @default(1)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  variant      ProductVariant         @relation(fields: [variantId], references: [id])
  store        Store                  @relation(fields: [storeId], references: [id])
  vendor       Vendor                 @relation(fields: [vendorId], references: [id])
  country      Country                @relation(fields: [countryId], references: [id])
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@index([storeId, countryId])
  @@index([vendorId, countryId])
}

model InventoryMovement {
  id               String                @id @default(uuid()) @db.Uuid
  inventoryId      String                @db.Uuid
  inventoryVersion Int
  kind             InventoryMovementKind
  commandKey       String                @db.VarChar(128)
  payloadHash      String                @db.VarChar(64)
  reservationId    String?               @db.Uuid
  onHandDelta      Int                   @default(0)
  reservedDelta    Int                   @default(0)
  onHandAfter      Int
  reservedAfter    Int
  reason           String                @db.VarChar(512)
  actorUserId      String?               @db.Uuid
  createdAt        DateTime              @default(now())
  inventory        Inventory             @relation(fields: [inventoryId], references: [id])
  reservation      InventoryReservation? @relation(fields: [reservationId], references: [id])
  actor            User?                 @relation(fields: [actorUserId], references: [id])

  @@unique([inventoryId, commandKey])
  @@unique([inventoryId, inventoryVersion])
  @@index([inventoryId, createdAt])
  @@index([reservationId])
}

model InventoryReservation {
  id                String                    @id @default(uuid()) @db.Uuid
  inventoryId       String                    @db.Uuid
  userId            String                    @db.Uuid
  commandKey        String                    @db.VarChar(128)
  payloadHash       String                    @db.VarChar(64)
  quantity          Int
  state             InventoryReservationState @default(ACTIVE)
  expiresAt         DateTime
  closedAt          DateTime?
  version           Int                       @default(1)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  inventory         Inventory                 @relation(fields: [inventoryId], references: [id])
  user              User                      @relation(fields: [userId], references: [id])
  movements         InventoryMovement[]
  checkoutQuoteItem CheckoutQuoteItem?

  @@unique([userId, commandKey])
  @@index([inventoryId, state])
  @@index([state, expiresAt])
  @@index([userId, state, createdAt])
}

enum CheckoutQuoteState {
  RESERVED
  RELEASED
  EXPIRED
}

model Cart {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  countryId String          @db.Uuid
  currency  String          @db.VarChar(3)
  version   Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  country   Country         @relation(fields: [countryId], references: [id])
  items     CartItem[]
  quotes    CheckoutQuote[]

  @@unique([userId, countryId])
  @@index([countryId, createdAt])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  storeId   String         @db.Uuid
  vendorId  String         @db.Uuid
  countryId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  store     Store          @relation(fields: [storeId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId, createdAt])
  @@index([variantId])
}

model CheckoutQuote {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @db.Uuid
  countryId         String               @db.Uuid
  cartId            String               @db.Uuid
  cartVersion       Int
  destinationCityId String               @db.Uuid
  commandKey        String               @db.VarChar(128)
  payloadHash       String               @db.VarChar(64)
  currency          String               @db.VarChar(3)
  subtotalMinor     BigInt
  state             CheckoutQuoteState   @default(RESERVED)
  expiresAt         DateTime
  closedAt          DateTime?
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id])
  country           Country              @relation(fields: [countryId], references: [id])
  cart              Cart                 @relation(fields: [cartId], references: [id])
  destinationCity   City                 @relation("CheckoutQuoteDestinationCity", fields: [destinationCityId], references: [id])
  groups            CheckoutQuoteGroup[]
  items             CheckoutQuoteItem[]

  @@unique([userId, commandKey])
  @@index([userId, state, createdAt])
  @@index([cartId, state])
  @@index([state, expiresAt])
}

model CheckoutQuoteGroup {
  id            String              @id @default(uuid()) @db.Uuid
  quoteId       String              @db.Uuid
  vendorId      String              @db.Uuid
  storeId       String              @db.Uuid
  currency      String              @db.VarChar(3)
  subtotalMinor BigInt
  createdAt     DateTime            @default(now())
  quote         CheckoutQuote       @relation(fields: [quoteId], references: [id])
  store         Store               @relation(fields: [storeId], references: [id])
  items         CheckoutQuoteItem[]

  @@unique([quoteId, vendorId, storeId])
  @@index([quoteId])
}

model CheckoutQuoteItem {
  id             String               @id @default(uuid()) @db.Uuid
  quoteId        String               @db.Uuid
  groupId        String               @db.Uuid
  reservationId  String               @unique @db.Uuid
  variantId      String               @db.Uuid
  productId      String               @db.Uuid
  productTitle   String               @db.VarChar(200)
  sku            String               @db.VarChar(120)
  quantity       Int
  unitPriceMinor BigInt
  lineTotalMinor BigInt
  currency       String               @db.VarChar(3)
  createdAt      DateTime             @default(now())
  quote          CheckoutQuote        @relation(fields: [quoteId], references: [id])
  group          CheckoutQuoteGroup   @relation(fields: [groupId], references: [id])
  reservation    InventoryReservation @relation(fields: [reservationId], references: [id])
  variant        ProductVariant       @relation(fields: [variantId], references: [id])

  @@unique([quoteId, variantId])
  @@index([quoteId])
  @@index([groupId])
}
