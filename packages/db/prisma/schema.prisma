generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AssuranceLevel {
  PASSWORD
  MFA
  STEP_UP
}

enum SessionState {
  ACTIVE
  REVOKED
  EXPIRED
}

enum GeographyType {
  COUNTRY
  REGION
  DISTRICT
  CITY
  ZONE
  NEIGHBORHOOD
}

enum AreaStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ActorType {
  USER
  SYSTEM
  PROVIDER
  AI_AGENT
}

enum MfaState {
  PENDING
  ACTIVE
  REVOKED
}

enum StorageObjectState {
  PENDING_UPLOAD
  UPLOADED
  QUARANTINED
  DELETED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum KycSubjectType {
  VENDOR
  RIDER
  ADMIN
}

enum KycCaseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum KycDecision {
  START_REVIEW
  APPROVE
  REJECT
  REQUEST_MORE_INFORMATION
  REVOKE
}

enum PartyStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RESTRICTED
}

enum VendorMembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum RiderVehicleType {
  BICYCLE
  MOTORBIKE
  CAR
  OTHER
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum ServiceabilityStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum StoreServiceAreaStatus {
  DRAFT
  APPROVED
  REJECTED
  SUSPENDED
}

enum RiderShiftStatus {
  ACTIVE
  ENDED
}

enum DispatchRunStatus {
  SEARCHING
  OFFERING
  ASSIGNED
  MANUAL_REVIEW
}

enum DispatchOfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum RiderAssignmentStatus {
  ACTIVE
  RELEASED
  COMPLETED
}

enum RoadRoutingMode {
  DISABLED
  TEST_ONLY
  GOOGLE_ROUTES
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductModerationState {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CategoryStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum ProductImageStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InventoryMovementKind {
  ADJUST
  RESERVE
  RELEASE
  CONSUME
  EXPIRE
  RESTOCK
}

enum InventoryReservationState {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id                          String                      @id @default(uuid()) @db.Uuid
  emailNormalized             String?                     @unique
  emailVerifiedAt             DateTime?
  phoneE164                   String?
  phoneVerifiedAt             DateTime?
  displayName                 String
  status                      UserStatus                  @default(ACTIVE)
  authorizationVersion        Int                         @default(1)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  identities                  UserIdentity[]
  sessions                    Session[]
  roles                       UserRole[]
  scopes                      AdminScope[]
  auditLogs                   AuditLog[]
  mfa                         UserMfa?
  recoveryCodes               RecoveryCode[]
  storageObjects              StorageObject[]
  reviewedStorageObjects      StorageObject[]             @relation("StorageObjectReviewedBy")
  submittedPayoutDestinations PayoutDestination[]         @relation("PayoutDestinationSubmitter")
  reviewedPayoutDestinations  PayoutDestination[]         @relation("PayoutDestinationReviewer")
  payoutDestinationReviews    PayoutDestinationReview[]   @relation("PayoutDestinationReviewActor")
  commissionPolicies          VendorCommissionPolicy[]    @relation("CommissionPolicyCreator")
  createdSettlements          VendorSettlement[]          @relation("SettlementCreator")
  reviewedSettlements         VendorSettlement[]          @relation("SettlementReviewer")
  settlementReviews           VendorSettlementReview[]    @relation("SettlementReviewActor")
  ledgerAccounts              LedgerAccount[]
  ledgerJournals              LedgerJournal[]
  kycCases                    KycCase[]                   @relation("KycCaseSubject")
  kycReviews                  KycReview[]                 @relation("KycReviewReviewer")
  kycDocumentsLinked          KycDocument[]               @relation("KycDocumentLinkedBy")
  ownedVendors                Vendor[]                    @relation("VendorOwner")
  activatedVendors            Vendor[]                    @relation("VendorActivatedBy")
  vendorMemberships           VendorMembership[]
  riderProfile                RiderProfile?               @relation("RiderProfileUser")
  activatedRiderProfiles      RiderProfile[]              @relation("RiderActivatedBy")
  activatedStores             Store[]                     @relation("StoreActivatedBy")
  createdProducts             Product[]                   @relation("ProductCreatedBy")
  reviewedProducts            Product[]                   @relation("ProductReviewedBy")
  publishedProducts           Product[]                   @relation("ProductPublishedBy")
  createdCategories           Category[]                  @relation("CategoryCreatedBy")
  activatedCategories         Category[]                  @relation("CategoryActivatedBy")
  createdProductImages        ProductImage[]              @relation("ProductImageCreatedBy")
  reviewedProductImages       ProductImage[]              @relation("ProductImageReviewedBy")
  inventoryMovements          InventoryMovement[]
  inventoryReservations       InventoryReservation[]
  carts                       Cart[]
  checkoutQuotes              CheckoutQuote[]
  orders                      Order[]
  paymentIntents              PaymentIntent[]
  codPoliciesCreated          CodPolicy[]                 @relation("CodPolicyCreatedBy")
  codPoliciesUpdated          CodPolicy[]                 @relation("CodPolicyUpdatedBy")
  subordersAccepted           VendorSuborder[]            @relation("SuborderAcceptedBy")
  subordersReady              VendorSuborder[]            @relation("SuborderReadyConfirmedBy")
  subordersRejected           VendorSuborder[]            @relation("SuborderRejectedBy")
  suborderStatusEvents        VendorSuborderStatusEvent[] @relation("SuborderStatusActor")
  storePickupsProposed        StorePickupPoint[]          @relation("StorePickupProposedBy")
  storePickupsReviewed        StorePickupPoint[]          @relation("StorePickupReviewedBy")
  storeServiceAreasProposed   StoreServiceArea[]          @relation("StoreServiceAreaProposedBy")
  storeServiceAreasReviewed   StoreServiceArea[]          @relation("StoreServiceAreaReviewedBy")
  riderZoneGrantsGranted      RiderZoneGrant[]            @relation("RiderZoneGrantGrantedBy")
  deliveryDestinationsSet     OrderDeliveryDestination[]  @relation("DeliveryDestinationSetBy")
  dispatchRunsCreated         DispatchRun[]               @relation("DispatchRunCreatedBy")
  dispatchEvents              DispatchEvent[]             @relation("DispatchEventActor")
  deliveryRecipientsSet       DeliveryRecipient[]         @relation("DeliveryRecipientSetBy")
  deliveryProofsVerified      DeliveryProof[]             @relation("DeliveryProofVerifiedBy")
  deliveryEvents              DeliveryEvent[]             @relation("DeliveryEventActor")
  deliveryOtpAttempts         DeliveryOtpAttempt[]        @relation("DeliveryOtpAttemptActor")
  orderCancellations          OrderCancellation[]         @relation("OrderCancellationBuyer")
  refundRequests              RefundRequest[]             @relation("RefundRequestBuyer")
  refundReviews               RefundReview[]              @relation("RefundReviewer")
  riderRateRules              RiderRateRule[]             @relation("RiderRateRuleCreatedBy")
  codDepositsSubmitted        CodDeposit[]                @relation("CodDepositSubmittedBy")
  codDepositsReviewed         CodDeposit[]                @relation("CodDepositReviewedBy")
  refundExecutions            RefundExecution[]           @relation("RefundExecutionCreator")
  vendorPayouts               VendorPayout[]              @relation("PayoutCreator")
  transferAttempts            TransferAttempt[]           @relation("TransferAttemptActor")
  adjustmentsCreated          FinanceAdjustment[]         @relation("AdjustmentCreator")
  adjustmentsReviewed         FinanceAdjustment[]         @relation("AdjustmentReviewer")
  statementImports            ProviderStatementEntry[]    @relation("StatementImporter")
  adminActivations            AdminActivation[]           @relation("AdminActivationUser")
  adminInvitations            AdminActivation[]           @relation("AdminActivationInviter")
  adminActivated              AdminActivation[]           @relation("AdminActivationActivator")
  retentionPolicies           KycRetentionPolicy[]        @relation("RetentionPolicyCreator")
  legalHoldsPlaced            KycLegalHold[]              @relation("LegalHoldPlacedBy")
  legalHoldsReleased          KycLegalHold[]              @relation("LegalHoldReleasedBy")
  deletionsRequested          KycDeletionRequest[]        @relation("DeletionRequestedBy")
  deletionsReviewed           KycDeletionRequest[]        @relation("DeletionReviewedBy")
  riskCasesOpened     RiskCase[]       @relation("RiskCaseOpenedBy")
  riskCasesResolved   RiskCase[]       @relation("RiskCaseResolvedBy")
  riskCasesSubject    RiskCase[]       @relation("RiskCaseSubject")
  riskCaseReviews     RiskCaseReview[] @relation("RiskCaseReviewer")
  notifications       Notification[]   @relation("NotificationUser")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceUser")
}

model UserIdentity {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  issuer                String
  subject               String
  providerKey           String
  providerEmailVerified Boolean  @default(false)
  linkedAt              DateTime @default(now())
  lastVerifiedAt        DateTime
  user                  User     @relation(fields: [userId], references: [id])

  @@unique([issuer, subject])
  @@unique([userId, issuer])
}

model Role {
  id               String            @id @default(uuid()) @db.Uuid
  key              String            @unique
  name             String
  description      String?
  permissions      RolePermission[]
  users            UserRole[]
  adminActivations AdminActivation[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  resource    String
  action      String
  sensitivity String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  roleId           String            @db.Uuid
  grantedBy        String            @db.Uuid
  expiresAt        DateTime?
  revokedAt        DateTime?
  user             User              @relation(fields: [userId], references: [id])
  role             Role              @relation(fields: [roleId], references: [id])
  adminActivations AdminActivation[]

  @@unique([userId, roleId])
}

model AdminScope {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  geographyType   GeographyType
  countryId       String?          @db.Uuid
  regionId        String?          @db.Uuid
  districtId      String?          @db.Uuid
  cityId          String?          @db.Uuid
  serviceZoneId   String?          @db.Uuid
  neighborhoodId  String?          @db.Uuid
  grantedBy       String           @db.Uuid
  effectiveFrom   DateTime         @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  user            User             @relation(fields: [userId], references: [id])
  adminActivation AdminActivation?

  @@index([userId, revokedAt])
}

model Session {
  id                     String         @id @default(uuid()) @db.Uuid
  userId                 String         @db.Uuid
  tokenHash              String         @unique
  assuranceLevel         AssuranceLevel @default(PASSWORD)
  state                  SessionState   @default(ACTIVE)
  encryptedTokenEnvelope Bytes?
  expiresAt              DateTime
  idleExpiresAt          DateTime
  revokedAt              DateTime?
  revokedReason          String?        @db.VarChar(120)
  authVersion            Int
  deviceLabel            String?        @db.VarChar(120)
  ipHash                 String?        @db.VarChar(64)
  userAgentHash          String?        @db.VarChar(64)
  stepUpExpiresAt        DateTime?
  createdAt              DateTime       @default(now())
  user                   User           @relation(fields: [userId], references: [id])

  @@index([userId, state])
}

model Country {
  id                   String                     @id @default(uuid()) @db.Uuid
  iso2                 String                     @unique
  name                 String
  currencyCode         String
  callingCode          String
  timezone             String
  status               AreaStatus                 @default(DRAFT)
  regions              Region[]
  kycCases             KycCase[]
  vendors              Vendor[]
  riderProfiles        RiderProfile[]
  stores               Store[]
  products             Product[]
  categories           Category[]
  productImages        ProductImage[]
  inventories          Inventory[]
  carts                Cart[]
  checkoutQuotes       CheckoutQuote[]
  orders               Order[]
  codPolicies          CodPolicy[]
  deliveryDestinations OrderDeliveryDestination[]
  dispatchRuns         DispatchRun[]
  riderAssignments     RiderAssignment[]
  DeliveryRecipient    DeliveryRecipient[]
  Delivery             Delivery[]
  orderCancellations   OrderCancellation[]        @relation("OrderCancellationCountry")
  refundRequests       RefundRequest[]            @relation("RefundRequestCountry")
  riderRateRules       RiderRateRule[]            @relation("RiderRateRuleCountry")
  riderRateSnapshots   RiderRateSnapshot[]        @relation("RiderRateSnapshotCountry")
  riderEarnings        RiderEarning[]             @relation("RiderEarningCountry")
  codCollections       CodCollection[]            @relation("CodCollectionCountry")
  codDeposits          CodDeposit[]               @relation("CodDepositCountry")
  payoutDestinations   PayoutDestination[]        @relation("PayoutDestinationCountry")
  commissionPolicies   VendorCommissionPolicy[]   @relation("CommissionPolicyCountry")
  vendorSettlements    VendorSettlement[]         @relation("VendorSettlementCountry")
  vendorPayouts        VendorPayout[]             @relation("VendorPayoutCountry")
  financeAdjustments   FinanceAdjustment[]        @relation("FinanceAdjustmentCountry")
  statementEntries     ProviderStatementEntry[]   @relation("StatementCountry")
  adminActivations     AdminActivation[]          @relation("AdminActivationCountry")
  retentionPolicies    KycRetentionPolicy[]       @relation("RetentionPolicyCountry")
  legalHolds           KycLegalHold[]             @relation("LegalHoldCountry")
  deletionRequests     KycDeletionRequest[]       @relation("DeletionCountry")
  retentionEvents      KycRetentionEvent[]        @relation("RetentionEventCountry")
  riskCases           RiskCase[] @relation("RiskCaseCountry")
}

model Region {
  id        String     @id @default(uuid()) @db.Uuid
  countryId String     @db.Uuid
  code      String
  name      String
  status    AreaStatus @default(DRAFT)
  country   Country    @relation(fields: [countryId], references: [id])
  districts District[]

  @@unique([countryId, code])
}

model District {
  id       String     @id @default(uuid()) @db.Uuid
  regionId String     @db.Uuid
  code     String
  name     String
  status   AreaStatus @default(DRAFT)
  region   Region     @relation(fields: [regionId], references: [id])
  cities   City[]

  @@unique([regionId, code])
}

model City {
  id                   String                     @id @default(uuid()) @db.Uuid
  districtId           String                     @db.Uuid
  code                 String
  name                 String
  kind                 String
  status               AreaStatus                 @default(DRAFT)
  district             District                   @relation(fields: [districtId], references: [id])
  zones                ServiceZone[]
  stores               Store[]
  checkoutQuotes       CheckoutQuote[]            @relation("CheckoutQuoteDestinationCity")
  orders               Order[]                    @relation("OrderDestinationCity")
  deliveryDestinations OrderDeliveryDestination[] @relation("DeliveryDestinationCity")

  @@unique([districtId, code])
}

model ServiceZone {
  id                      String                     @id @default(uuid()) @db.Uuid
  cityId                  String                     @db.Uuid
  code                    String
  name                    String
  status                  AreaStatus                 @default(DRAFT)
  priority                Int                        @default(0)
  city                    City                       @relation(fields: [cityId], references: [id])
  neighborhoods           Neighborhood[]
  storeServiceAreas       StoreServiceArea[]
  riderZoneGrants         RiderZoneGrant[]
  deliveryDestinations    OrderDeliveryDestination[]
  pickupDispatchRuns      DispatchRun[]              @relation("DispatchPickupZone")
  destinationDispatchRuns DispatchRun[]              @relation("DispatchDestinationZone")

  @@unique([cityId, code])
}

model Neighborhood {
  id            String      @id @default(uuid()) @db.Uuid
  serviceZoneId String      @db.Uuid
  code          String
  name          String
  zone          ServiceZone @relation(fields: [serviceZoneId], references: [id])

  @@unique([serviceZoneId, code])
}

model BoundaryVersion {
  id          String                                     @id @default(uuid()) @db.Uuid
  ownerType   GeographyType
  ownerId     String                                     @db.Uuid
  version     Int
  boundary    Unsupported("geometry(MultiPolygon,4326)")
  source      String
  validFrom   DateTime
  approvedBy  String?                                    @db.Uuid
  contentHash String
  createdAt   DateTime                                   @default(now())

  deliveryDestinations OrderDeliveryDestination[]

  @@unique([ownerType, ownerId, version])
}

model StorePickupPoint {
  id               String                              @id @default(uuid()) @db.Uuid
  storeId          String                              @unique @db.Uuid
  pickupPoint      Unsupported("geometry(Point,4326)")
  status           ServiceabilityStatus                @default(DRAFT)
  proposedByUserId String                              @db.Uuid
  reviewedByUserId String?                             @db.Uuid
  reviewReason     String?                             @db.VarChar(512)
  reviewedAt       DateTime?
  version          Int                                 @default(1)
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  store            Store                               @relation(fields: [storeId], references: [id])
  proposedBy       User                                @relation("StorePickupProposedBy", fields: [proposedByUserId], references: [id])
  reviewedBy       User?                               @relation("StorePickupReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([status])
}

model StoreOperatingHour {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @db.Uuid
  dayOfWeek   Int
  openMinute  Int
  closeMinute Int
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, dayOfWeek, openMinute])
  @@index([storeId, dayOfWeek])
}

model StoreServiceArea {
  id               String                 @id @default(uuid()) @db.Uuid
  storeId          String                 @db.Uuid
  serviceZoneId    String                 @db.Uuid
  status           StoreServiceAreaStatus @default(DRAFT)
  proposedByUserId String                 @db.Uuid
  reviewedByUserId String?                @db.Uuid
  reviewReason     String?                @db.VarChar(512)
  reviewedAt       DateTime?
  version          Int                    @default(1)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  store            Store                  @relation(fields: [storeId], references: [id])
  serviceZone      ServiceZone            @relation(fields: [serviceZoneId], references: [id])
  proposedBy       User                   @relation("StoreServiceAreaProposedBy", fields: [proposedByUserId], references: [id])
  reviewedBy       User?                  @relation("StoreServiceAreaReviewedBy", fields: [reviewedByUserId], references: [id])

  @@unique([storeId, serviceZoneId])
  @@index([serviceZoneId, status])
}

model RiderShift {
  id              String                @id @default(uuid()) @db.Uuid
  riderId         String                @db.Uuid
  status          RiderShiftStatus      @default(ACTIVE)
  consentVersion  String                @db.VarChar(64)
  startedAt       DateTime              @default(now())
  endedAt         DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  rider           RiderProfile          @relation(fields: [riderId], references: [id])
  locationSamples RiderLocationSample[]
  dispatchOffers  DispatchOffer[]
  assignments     RiderAssignment[]

  @@index([riderId, status])
}

model RiderLocationConsent {
  id             String       @id @default(uuid()) @db.Uuid
  riderId        String       @unique @db.Uuid
  consented      Boolean      @default(false)
  consentVersion String       @db.VarChar(64)
  updatedAt      DateTime     @updatedAt
  rider          RiderProfile @relation(fields: [riderId], references: [id])
}

model RiderLocationSample {
  id             String                              @id @default(uuid()) @db.Uuid
  riderId        String                              @db.Uuid
  shiftId        String                              @db.Uuid
  location       Unsupported("geometry(Point,4326)")
  accuracyMeters Int
  recordedAt     DateTime
  receivedAt     DateTime                            @default(now())
  rider          RiderProfile                        @relation(fields: [riderId], references: [id])
  shift          RiderShift                          @relation(fields: [shiftId], references: [id])
  dispatchOffers DispatchOffer[]
  assignments    RiderAssignment[]

  @@index([riderId, receivedAt])
  @@index([shiftId, receivedAt])
}

model RiderZoneGrant {
  id                     String          @id @default(uuid()) @db.Uuid
  riderId                String          @db.Uuid
  serviceZoneId          String          @db.Uuid
  grantedBy              String          @db.Uuid
  reason                 String          @db.VarChar(512)
  expiresAt              DateTime?
  revokedAt              DateTime?
  createdAt              DateTime        @default(now())
  rider                  RiderProfile    @relation(fields: [riderId], references: [id])
  serviceZone            ServiceZone     @relation(fields: [serviceZoneId], references: [id])
  grantor                User            @relation("RiderZoneGrantGrantedBy", fields: [grantedBy], references: [id])
  pickupOfferGrants      DispatchOffer[] @relation("DispatchOfferPickupGrant")
  destinationOfferGrants DispatchOffer[] @relation("DispatchOfferDestinationGrant")

  @@index([riderId, revokedAt])
  @@index([serviceZoneId, revokedAt])
}

model OrderDeliveryDestination {
  id                String                              @id @default(uuid()) @db.Uuid
  orderId           String                              @unique @db.Uuid
  countryId         String                              @db.Uuid
  cityId            String                              @db.Uuid
  serviceZoneId     String                              @db.Uuid
  boundaryVersionId String                              @db.Uuid
  destinationPoint  Unsupported("geometry(Point,4326)")
  addressLine       String                              @db.VarChar(500)
  commandKey        String                              @db.VarChar(128)
  payloadHash       String                              @db.VarChar(64)
  setByUserId       String                              @db.Uuid
  createdAt         DateTime                            @default(now())
  order             Order                               @relation(fields: [orderId], references: [id])
  country           Country                             @relation(fields: [countryId], references: [id])
  city              City                                @relation("DeliveryDestinationCity", fields: [cityId], references: [id])
  serviceZone       ServiceZone                         @relation(fields: [serviceZoneId], references: [id])
  boundaryVersion   BoundaryVersion                     @relation(fields: [boundaryVersionId], references: [id])
  setBy             User                                @relation("DeliveryDestinationSetBy", fields: [setByUserId], references: [id])
  dispatchRuns      DispatchRun[]

  @@index([serviceZoneId])
}

model DispatchRun {
  id                String                              @id @default(uuid()) @db.Uuid
  suborderId        String                              @unique @db.Uuid
  countryId         String                              @db.Uuid
  storeId           String                              @db.Uuid
  destinationId     String                              @db.Uuid
  pickupZoneId      String                              @db.Uuid
  destinationZoneId String                              @db.Uuid
  pickupPoint       Unsupported("geometry(Point,4326)")
  destinationPoint  Unsupported("geometry(Point,4326)")
  status            DispatchRunStatus                   @default(SEARCHING)
  version           Int                                 @default(1)
  attemptCount      Int                                 @default(0)
  maxAttempts       Int                                 @default(5)
  commandKey        String                              @db.VarChar(128)
  payloadHash       String                              @db.VarChar(64)
  createdByUserId   String                              @db.Uuid
  createdAt         DateTime                            @default(now())
  updatedAt         DateTime                            @updatedAt
  suborder          VendorSuborder                      @relation(fields: [suborderId], references: [id])
  country           Country                             @relation(fields: [countryId], references: [id])
  store             Store                               @relation(fields: [storeId], references: [id])
  destination       OrderDeliveryDestination            @relation(fields: [destinationId], references: [id])
  pickupZone        ServiceZone                         @relation("DispatchPickupZone", fields: [pickupZoneId], references: [id])
  destinationZone   ServiceZone                         @relation("DispatchDestinationZone", fields: [destinationZoneId], references: [id])
  createdBy         User                                @relation("DispatchRunCreatedBy", fields: [createdByUserId], references: [id])
  offers            DispatchOffer[]
  assignment        RiderAssignment?
  events            DispatchEvent[]

  @@index([countryId, status, createdAt])
  @@index([storeId, status])
  @@index([status, updatedAt])
}

model DispatchOffer {
  id                     String              @id @default(uuid()) @db.Uuid
  runId                  String              @db.Uuid
  riderId                String              @db.Uuid
  sequence               Int
  status                 DispatchOfferStatus @default(OFFERED)
  offerTokenHash         String              @db.VarChar(64)
  shiftId                String              @db.Uuid
  locationSampleId       String              @db.Uuid
  pickupZoneGrantId      String              @db.Uuid
  destinationZoneGrantId String              @db.Uuid
  pickupDistanceMeters   Int
  roadDistanceMeters     Int
  durationSeconds        Int?
  routingProvider        String              @db.VarChar(40)
  routingMode            RoadRoutingMode
  routeEvidenceHash      String              @db.VarChar(64)
  commandKey             String              @db.VarChar(128)
  payloadHash            String              @db.VarChar(64)
  offeredAt              DateTime            @default(now())
  expiresAt              DateTime
  respondedAt            DateTime?
  responseCommandKey     String?             @db.VarChar(128)
  responsePayloadHash    String?             @db.VarChar(64)
  responseReason         String?             @db.VarChar(512)
  run                    DispatchRun         @relation(fields: [runId], references: [id])
  rider                  RiderProfile        @relation(fields: [riderId], references: [id])
  shift                  RiderShift          @relation(fields: [shiftId], references: [id])
