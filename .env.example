# Development template only. Never commit real secrets. Live flags default false.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://getstoopy:CHANGE_ME_LOCAL_ONLY@localhost:5432/getstoopy?schema=public
REDIS_URL=redis://localhost:6379
KEYCLOAK_ISSUER=http://localhost:8080/realms/get-stoopy
KEYCLOAK_CLIENT_ID=get-stoopy-web
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_LOCAL_ONLY
SESSION_COOKIE_NAME=gs_session_dev
SESSION_IDLE_MINUTES=15
PRIVILEGED_ABSOLUTE_HOURS=8
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET_KYC=getstoopy-kyc-private
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
KMS_KEY_REFERENCE=local-dev-only
MAPS_PROVIDER=disabled
PAYMENTS_LIVE_ENABLED=false
# Sandbox/manual payment testing only; never enable in production. Secret must be supplied out-of-band.
PAYMENTS_SANDBOX_ENABLED=false
PAYMENT_SANDBOX_WEBHOOK_SECRET=
BANGLA_QR_ENABLED=false
PAYOUTS_LIVE_ENABLED=false
CROSS_BORDER_ENABLED=false
AI_ENABLED=false

# Phase-2 API/BFF development additions (local only; replace before use)
DATABASE_MIGRATION_URL=postgresql://gs_owner:CHANGE_ME_LOCAL_ONLY@localhost:5432/getstoopy?schema=public
DATABASE_PRIVILEGED_URL=postgresql://gs_privileged:CHANGE_ME_LOCAL_ONLY@localhost:5432/getstoopy?schema=public
BFF_API_SHARED_SECRET=CHANGE_ME_LOCAL_ONLY_AT_LEAST_32_CHARS
SESSION_TOKEN_ENCRYPTION_KEY=CHANGE_ME_LOCAL_ONLY_64_HEX_CHARS
API_INTERNAL_URL=http://localhost:4000

# Local Keycloak database role password (local only)
KEYCLOAK_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Optional local-only OIDC smoke verification identity; never use real customer data
LOCAL_VERIFY_USERNAME=
LOCAL_VERIFY_PASSWORD=

# Local worker/outbox settings
WORKER_QUEUE=get-stoopy.domain
WORKER_CONCURRENCY=4
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
# Visibility lease for the PostgreSQL -> Redis publish window (1s..5m).
OUTBOX_LEASE_MS=30000

# Inventory reservation expiry worker (local only; requires privileged DB URL).
INVENTORY_EXPIRY_ENABLED=false
INVENTORY_EXPIRY_POLL_MS=5000
INVENTORY_EXPIRY_BATCH_SIZE=100

# Private encrypted object storage (local development adapter)
STORAGE_LOCAL_DIR=.local/private-storage
STORAGE_ENCRYPTION_KEY=CHANGE_ME_LOCAL_ONLY_64_HEX_CHARS

# Atomic dispatch / road routing (local development only; live paid routing remains unauthorized).
ROAD_ROUTING_ENABLED=false
ROAD_ROUTING_PROVIDER=disabled
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
DISPATCH_OFFER_TOKEN_SECRET=
DISPATCH_EXPIRY_ENABLED=false
DISPATCH_EXPIRY_POLL_MS=1000
DISPATCH_EXPIRY_BATCH_SIZE=100
