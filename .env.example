# Development template only. Never commit real secrets. Live flags default false.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://getstoopy:CHANGE_ME_LOCAL_ONLY@localhost:5432/getstoopy?schema=public
REDIS_URL=redis://localhost:6379
KEYCLOAK_ISSUER=http://localhost:8080/realms/get-stoopy
KEYCLOAK_CLIENT_ID=get-stoopy-web
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_LOCAL_ONLY
SESSION_COOKIE_NAME=gs_session_dev
SESSION_IDLE_MINUTES=15
PRIVILEGED_ABSOLUTE_HOURS=8
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET_KYC=getstoopy-kyc-private
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
KMS_KEY_REFERENCE=local-dev-only
MAPS_PROVIDER=disabled
PAYMENTS_LIVE_ENABLED=false
BANGLA_QR_ENABLED=false
PAYOUTS_LIVE_ENABLED=false
CROSS_BORDER_ENABLED=false
AI_ENABLED=false

# Phase-2 API/BFF development additions (local only; replace before use)
DATABASE_MIGRATION_URL=postgresql://gs_owner:CHANGE_ME_LOCAL_ONLY@localhost:5432/getstoopy?schema=public
DATABASE_PRIVILEGED_URL=postgresql://gs_privileged:CHANGE_ME_LOCAL_ONLY@localhost:5432/getstoopy?schema=public
BFF_API_SHARED_SECRET=CHANGE_ME_LOCAL_ONLY_AT_LEAST_32_CHARS
SESSION_TOKEN_ENCRYPTION_KEY=CHANGE_ME_LOCAL_ONLY_64_HEX_CHARS
API_INTERNAL_URL=http://localhost:4000

# Local Keycloak database role password (local only)
KEYCLOAK_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Optional local-only OIDC smoke verification identity; never use real customer data
LOCAL_VERIFY_USERNAME=
