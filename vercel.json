{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "autoAlias": false
  },
  "ignoreCommand": "node scripts/vercel-preview-only.mjs",
  "framework": "nextjs",
  "installCommand": "npm install --global npm@10.8.2 && npm ci --no-audit --no-fund",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "apps/web/.next"
}
