{
  "name": "get-stoopy",
  "private": true,
  "version": "0.2.0-foundation",
  "description": "Get Stoopy marketplace — approved modular-monolith foundation",
  "engines": {
    "node": ">=20.19 <21",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:api && npm run build:web",
    "typecheck": "npm run build:packages && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:validate": "node scripts/prisma.mjs validate",
    "db:format": "node scripts/prisma.mjs format",
    "build:packages": "tsc -b packages/core packages/config packages/auth packages/observability packages/bff",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "next dev apps/web --hostname 0.0.0.0 --port 3000",
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "build:web": "next build apps/web",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx scripts/seed-local.ts"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "20.19.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "6.0.3",
    "autoprefixer": "10.4.21",
    "dotenv": "16.6.1",
    "postcss": "8.5.6",
    "prisma": "6.16.3",
    "supertest": "7.1.4",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.16.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie": "1.0.2",
    "helmet": "8.1.0",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "next": "15.5.28",
    "openid-client": "6.8.1",
    "pg": "8.16.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  }
}
