{
  "name": "get-stoopy",
  "private": true,
  "version": "0.2.0-foundation",
  "description": "Get Stoopy marketplace — approved modular-monolith foundation",
  "engines": {
    "node": ">=20.19 <21",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/config packages/auth packages/observability",
    "typecheck": "tsc -b packages/core packages/config packages/auth packages/observability",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:validate": "node scripts/prisma.mjs validate",
    "db:format": "node scripts/prisma.mjs format"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "dotenv": "16.6.1",
    "prisma": "6.16.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@prisma/client": "6.16.3",
    "zod": "3.25.76"
  }
}
