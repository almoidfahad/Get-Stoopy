digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.35",ranksep="0.8"];
node [shape=plain,fontname="Arial"];
edge [color="#68717d",fontcolor="#47505c",fontsize=9,fontname="Arial"];
AuditLog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#46515c"><FONT COLOR="white"><B>AuditLog</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>actorId</B></TD><TD ALIGN="LEFT">uuid nullable</TD></TR><TR><TD ALIGN="LEFT"><B>actorType</B></TD><TD ALIGN="LEFT">ActorType</TD></TR><TR><TD ALIGN="LEFT"><B>sessionId</B></TD><TD ALIGN="LEFT">uuid nullable</TD></TR><TR><TD ALIGN="LEFT"><B>action</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>resourceType</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>resourceId</B></TD><TD ALIGN="LEFT">uuid nullable</TD></TR><TR><TD ALIGN="LEFT"><B>scopeSnapshot</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>beforeRedacted</B></TD><TD ALIGN="LEFT">json nullable</TD></TR><TR><TD ALIGN="LEFT"><B>afterRedacted</B></TD><TD ALIGN="LEFT">json nullable</TD></TR><TR><TD ALIGN="LEFT"><B>reason</B></TD><TD ALIGN="LEFT">string nullable</TD></TR><TR><TD ALIGN="LEFT"><B>requestId</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>occurredAt</B></TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
FeatureFlag [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#46515c"><FONT COLOR="white"><B>FeatureFlag</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>key</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>countryId</B></TD><TD ALIGN="LEFT">uuid nullable</TD></TR><TR><TD ALIGN="LEFT"><B>environment</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>enabled</B></TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT"><B>rolloutRule</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>version</B></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>updatedBy</B></TD><TD ALIGN="LEFT">uuid</TD></TR></TABLE>>];
IdempotencyRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#46515c"><FONT COLOR="white"><B>IdempotencyRecord</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>actorId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>route</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>key</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>requestHash</B></TD><TD ALIGN="LEFT">bytes</TD></TR><TR><TD ALIGN="LEFT"><B>responseStatus</B></TD><TD ALIGN="LEFT">int nullable</TD></TR><TR><TD ALIGN="LEFT"><B>responseHash</B></TD><TD ALIGN="LEFT">bytes nullable</TD></TR><TR><TD ALIGN="LEFT"><B>resourceReference</B></TD><TD ALIGN="LEFT">string nullable</TD></TR><TR><TD ALIGN="LEFT"><B>expiresAt</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>state</B></TD><TD ALIGN="LEFT">IdempotencyState</TD></TR></TABLE>>];
InboxReceipt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#46515c"><FONT COLOR="white"><B>InboxReceipt</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>consumer</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>eventKey</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>processedAt</B></TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
Notification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#46515c"><FONT COLOR="white"><B>Notification</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>recipientId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>channel</B></TD><TD ALIGN="LEFT">NotificationChannel</TD></TR><TR><TD ALIGN="LEFT"><B>templateKey</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>templateVersion</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>payloadRedacted</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>status</B></TD><TD ALIGN="LEFT">NotificationStatus</TD></TR><TR><TD ALIGN="LEFT"><B>dedupeKey</B></TD><TD ALIGN="LEFT">string UNIQUE</TD></TR><TR><TD ALIGN="LEFT"><B>sentAt</B></TD><TD ALIGN="LEFT">datetime nullable</TD></TR></TABLE>>];
NotificationPreference [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#46515c"><FONT COLOR="white"><B>NotificationPreference</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>userId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>channel</B></TD><TD ALIGN="LEFT">NotificationChannel</TD></TR><TR><TD ALIGN="LEFT"><B>purpose</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>enabled</B></TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT"><B>policyVersion</B></TD><TD ALIGN="LEFT">string</TD></TR></TABLE>>];
OutboxEvent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#46515c"><FONT COLOR="white"><B>OutboxEvent</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>aggregateType</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>aggregateId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>eventKey</B></TD><TD ALIGN="LEFT">string UNIQUE</TD></TR><TR><TD ALIGN="LEFT"><B>eventType</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>payload</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>occurredAt</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>publishedAt</B></TD><TD ALIGN="LEFT">datetime nullable</TD></TR><TR><TD ALIGN="LEFT"><B>attempts</B></TD><TD ALIGN="LEFT">int</TD></TR></TABLE>>];
Country [shape=box,style="rounded,filled",fillcolor="#eef1f4",fontcolor="#39434e",label="Country
(external domain)"];
Session [shape=box,style="rounded,filled",fillcolor="#eef1f4",fontcolor="#39434e",label="Session
(external domain)"];
User [shape=box,style="rounded,filled",fillcolor="#eef1f4",fontcolor="#39434e",label="User
(external domain)"];
Notification -> User [label="recipientId (N:1, FK owner → target)"];
NotificationPreference -> User [label="userId (N:1, FK owner → target)"];
AuditLog -> User [label="actorId (N:1, FK owner → target)"];
IdempotencyRecord -> User [label="actorId (N:1, FK owner → target)"];
AuditLog -> Session [label="sessionId (N:1, FK owner → target)"];
FeatureFlag -> Country [label="countryId (N:1, FK owner → target)"];
FeatureFlag -> User [label="updatedBy (N:1, FK owner → target)"];
}