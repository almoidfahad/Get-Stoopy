digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.35",ranksep="0.8"];
node [shape=plain,fontname="Arial"];
edge [color="#68717d",fontcolor="#47505c",fontsize=9,fontname="Arial"];
CheckoutQuote [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#7a4b24"><FONT COLOR="white"><B>CheckoutQuote</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>checkoutId</B></TD><TD ALIGN="LEFT">uuid UNIQUE</TD></TR><TR><TD ALIGN="LEFT"><B>customerId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>recipientSnapshot</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>destinationAddressSnapshot</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>destinationZoneId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>totals</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>groupQuotes</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>pricingVersion</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>expiresAt</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>quoteHash</B></TD><TD ALIGN="LEFT">bytes</TD></TR></TABLE>>];
Order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d8dde3"><TR><TD COLSPAN="2" BGCOLOR="#7a4b24"><FONT COLOR="white"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>publicReference</B></TD><TD ALIGN="LEFT">string UNIQUE</TD></TR><TR><TD ALIGN="LEFT"><B>buyerId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>countryId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>destinationCountryId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>destinationZoneId</B></TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT"><B>status</B></TD><TD ALIGN="LEFT">ParentOrderStatus</TD></TR><TR><TD ALIGN="LEFT"><B>subtotalAmount</B></TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT"><B>deliveryFeeAmount</B></TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT"><B>discountAmount</B></TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT"><B>taxAmount</B></TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT"><B>totalAmount</B></TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT"><B>currency</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>pricingSnapshot</B></TD><TD ALIGN="LEFT">json</TD></TR><TR><TD ALIGN="LEFT"><B>riskCaseId</B></TD><TD ALIGN="LEFT">uuid nullable</TD></TR><TR><TD ALIGN="LEFT"><B>idempotencyKey</B></TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT"><B>version</B></TD><TD ALIGN="LEFT">int</TD></TR></TABLE>>];
