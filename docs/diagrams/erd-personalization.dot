(external domain)"];
User [shape=box,style="rounded,filled",fillcolor="#eef1f4",fontcolor="#39434e",label="User
(external domain)"];
ProductInteraction -> User [label="customerId (N:1, FK owner → target)"];
ProductInteraction -> Product [label="productId (N:1, FK owner → target)"];
PersonalizationProfile -> Customer [label="customerId (1:1, FK owner → target)"];
AIInvocation -> User [label="actorUserId (N:1, FK owner → target)"];
AIApproval -> AIInvocation [label="invocationId (1:1, FK owner → target)"];
ProductInteraction -> ProductVariant [label="variantId (N:1, FK owner → target)"];
ProductInteraction -> ConsentRecord [label="consentId (N:1, FK owner → target)"];
ProductInteraction -> ServiceZone [label="zoneId (N:1, FK owner → target)"];
AIInvocation -> AIApproval [label="approvalId (N:1, FK owner → target)"];
AIApproval -> User [label="approverId (N:1, FK owner → target)"];
AIApproval -> StepUpChallenge [label="stepUpChallengeId (N:1, FK owner → target)"];
}